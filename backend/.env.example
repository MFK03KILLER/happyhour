NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/happyhour
JWT_ACCESS_SECRET=change_me_access_secret_demo_only
JWT_REFRESH_SECRET=change_me_refresh_secret_demo_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_EMAIL=admin@happyhour.demo
ADMIN_PASSWORD=Admin@12345
QR_SIGNING_SECRET=change_me_qr_secret_demo_only
QR_TTL_SECONDS=60

# --- OAuth (Google only; Apple sign-in was removed) ---
# Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (type: Web).
# Paste the Client ID below (looks like 1234567890-xxxx.apps.googleusercontent.com).
# Add your customer-app origin to "Authorized JavaScript origins" (e.g. https://happyhourz.org).
GOOGLE_CLIENT_ID=

# --- Payments (see docs/PAYMENTS_SETUP.md) ---
# Public URL of the customer app, used to build Stripe redirect URLs.
APP_BASE_URL=https://happyhourz.org
# Leave the Stripe keys blank to stay in mock mode (no real charges).
# Setting STRIPE_SECRET_KEY automatically switches PAYMENTS_PROVIDER to 'stripe'.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy flag, kept for back-compat. Ignored once Stripe keys are set.
MOCK_PAYMENTS=true
