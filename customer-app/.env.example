VITE_API_BASE=http://localhost:4000/api/v1

# --- OAuth (Google only; Apple sign-in was removed) ---
# Same Google Client ID you put in backend/.env (GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# --- Payments ---
# Stripe publishable key (pk_live_... / pk_test_...). Leave blank while in mock mode.
VITE_STRIPE_PUBLISHABLE_KEY=
