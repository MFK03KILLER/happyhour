{
  "appId": "app.happyhour.merchant",
  "appName": "Happy Hour Merchant",
  "webDir": "dist",
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0E5C5C"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "happyhourz.org",
      "*.happyhourz.org"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#0E5C5C",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
